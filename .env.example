# 留空时自动进入明确标注的本地演示模式；不会请求模型或搜索服务。
# auto / live / demo
APP_MODE=auto
PORT=3210

# OpenAI 或兼容 Chat Completions 的服务。填写自己有权限使用的模型名称。
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
# json_object 兼容性较广；支持严格结构化输出的服务可使用 json_schema。
LLM_JSON_MODE=json_object
LLM_TIMEOUT_MS=60000

# 可选。缺少搜索密钥时明确显示搜索不可用，辅导仍可继续。
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
